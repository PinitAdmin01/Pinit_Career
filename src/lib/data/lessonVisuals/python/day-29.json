            "caption": "Changing the missing module name updates the fix message to pydantic.",
            "whatIf": "log = \"\"\"==> Installing dependencies\nSuccessfully installed fastapi-0.115.0\n==> Starting service\nTraceback (most recent call last):\n  File \"/app/api.py\", line 3, in <module>\n    import requests\nModuleNotFoundError: No module named 'pydantic'\"\"\"\n\nlast = log.strip().splitlines()[-1]\nprint(\"Last line:\", last)\nif last.startswith(\"ModuleNotFoundError\"):\n    package = last.split(\"'\")[1]\n    print(f\"Fix: add {package} to requirements.txt, commit and push\")",
            "checks": [
              "Last line: ModuleNotFoundError: No module named 'pydantic'",
              "Fix: add pydantic to requirements.txt, commit and push"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "Installing dependencies"
                  },
                  {
                    "text": "fastapi-0.115.0"
