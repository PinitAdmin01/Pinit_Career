    {
      "partTitle": "assert and failure messages",
      "codeHash": "ccd204a27183612cec3ba21861adeeef3f3a8af9aa17da8339bde2b07b034d03",
      "spec": {
        "template": "table",
        "title": "Inspecting assert failure messages",
        "columns": [
          "Call",
          "Expected",
          "Outcome"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "When an assert condition is False, Python raises AssertionError.",
            "checks": [
              "First check passed",
              "AssertionError"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "total([20, 45])"
                  },
                  {
                    "text": "65"
                  },
                  {
                    "text": "First check passed"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "total([20, 45, 10])"
                  },
                  {
                    "text": "70"
                  },
                  {
                    "text": "AssertionError"
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "Adding a message shows expected and actual values when assert fails.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "f\"expected 70, got {result}\""
                  },
                  {
                    "text": "70"
                  },
                  {
                    "text": "expected 70, got 75"
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Fixing the expected value lets both checks pass.",
            "whatIf": "def total(amounts):\n    return sum(amounts)\n\nresult = total([20, 45])\nassert result == 65, f\"expected 65, got {result}\"\nprint(\"First check passed\")\nresult = total([20, 45, 10])\nassert result == 75, f\"expected 75, got {result}\"\nprint(\"This line is never reached\")",
            "checks": [
              "First check passed",
              "This line is never reached"
            ],
            "mustNotShow": [
              "AssertionError"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "total([20, 45, 10])"
                  },
                  {
                    "text": "75"
                  },
                  {
                    "text": "First check passed"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      },
