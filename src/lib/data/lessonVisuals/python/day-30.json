    {
      "partTitle": "More classic small problems",
      "codeHash": "1a30aa9513e5b6b8e85ece4f552c94c844044c9db421343b58161d341811c929",
      "spec": {
        "template": "table",
        "title": "Four classic interview helpers side by side",
        "columns": [
          "Function / Pattern",
          "Output"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Splitting words, reversing slices, and counting tokens solve common problems.",
            "checks": [
              "Python love I",
              "True False",
              "[3, 1]",
              "[('the', 2)]"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "reverse_words(\"I love Python\")"
                  },
                  {
                    "text": "Python love I"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "is_palindrome(\"Malayalam\")"
                  },
                  {
                    "text": "True"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "is_palindrome(\"Python\")"
                  },
                  {
                    "text": "False"
                  }
                ],
                "tone": "data"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "Tracking seen values in a set lets a loop find duplicates cleanly.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "duplicates([3, 1, 3, 2, 1, 3])"
                  },
                  {
                    "text": "[3, 1]"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "Counter(\"the cat and the hat\".split()).most_common(1)"
                  },
                  {
                    "text": "[('the', 2)]"
                  }
                ],
                "tone": "data"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Writing largest with a loop keeps track of the biggest value seen.",
            "whatIf": "from collections import Counter\n\ndef reverse_words(sentence):\n    return \" \".join(reversed(sentence.split()))\n\ndef is_palindrome(word):\n    clean = word.lower()\n    return clean == clean[::-1]\n\ndef duplicates(items):\n    seen, dupes = set(), []\n    for x in items:\n        if x in seen and x not in dupes:\n            dupes.append(x)\n        seen.add(x)\n    return dupes\n\nprint(reverse_words(\"I love Python\"))\nprint(is_palindrome(\"Malayalam\"), is_palindrome(\"Python\"))\nprint(duplicates([3, 1, 3, 2, 1, 3]))\nprint(Counter(\"the cat and the hat\".split()).most_common(1))\ndef largest(numbers):\n    best = numbers[0]\n    for n in numbers[1:]:\n        if n > best:\n            best = n\n    return best\n\nprint(largest([3, 9, 2]), largest([7]))",
            "checks": [
              "9 7"
            ],
            "mustNotShow": [
              "Error"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "largest(numbers)"
