    {
      "partTitle": "Debugging is a normal part of the job",
      "codeHash": "3765c4b9a4b78916faa145507d0547a55c50418d4e75d5e8d6307eb73ddb36ed",
      "spec": {
        "template": "table",
        "title": "Five-step debugging workflow",
        "columns": [
          "Step",
          "Action"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Every developer fixes bugs calmly when the program acts different.",
            "checks": [
              "1. Reproduce the bug",
              "3. Find the line and the values",
              "5. Fix it and add a test"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "1"
                  },
                  {
                    "text": "Reproduce the bug"
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "2"
                  },
                  {
                    "text": "Read the error message"
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "3"
                  },
                  {
                    "text": "Find the line and the values"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "Bug fixes make debugging a key job-relevant skill for a junior developer.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "4"
                  },
                  {
                    "text": "Guess the cause and test the guess"
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "5"
                  },
                  {
                    "text": "Fix it and add a test"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Adding a sixth step completes the bug fix message cleanly.",
            "whatIf": "steps = [\n    \"Reproduce the bug\",\n    \"Read the error message\",\n    \"Find the line and the values\",\n    \"Guess the cause and test the guess\",\n    \"Fix it and add a test\",\n    \"Commit the fix with a clear message\",\n]\nfor number, step in enumerate(steps, start=1):\n    print(f\"{number}. {step}\")",
            "checks": [
              "6. Commit the fix with a clear message"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "5"
                  },
                  {
                    "text": "Fix it and add a test"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      },
