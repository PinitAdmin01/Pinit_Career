    {
      "partTitle": "The most common errors and their usual causes",
      "codeHash": "4093a382fa8267b4b6aeff9165963360057246789ea04e1e87b02770723864b1",
      "spec": {
        "template": "table",
        "title": "Seven common Python exception types and triggers",
        "columns": [
          "Error Type",
          "Failing Expression",
          "Reported Detail"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Learning common error types makes debugging beginner bugs much faster.",
            "checks": [
              "NameError: name 'totl' is not defined",
              "TypeError: unsupported operand type(s) for +: 'int' and 'str'",
              "KeyError: 'amont'",
              "IndexError: list index out of range",
              "AttributeError: 'NoneType' object has no attribute 'upper'",
              "ValueError: invalid literal for int() with base 10: 'abc'",
              "ZeroDivisionError: division by zero"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "NameError"
                  },
                  {
                    "text": "totl"
                  },
                  {
                    "text": "NameError"
                  }
                ],
                "tone": "error"
              },
              {
                "cells": [
                  {
                    "text": "KeyError"
                  },
                  {
                    "text": "'amont'"
                  },
                  {
                    "text": "KeyError"
                  }
                ],
                "tone": "error"
              },
              {
                "cells": [
                  {
                    "text": "IndexError"
                  },
                  {
                    "text": "[1, 2, 3][3]"
                  },
                  {
                    "text": "list index out of range"
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "NameError and KeyError flag misspelt names while IndexError flags list bounds.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "AttributeError"
                  },
                  {
                    "text": "None.upper()"
                  },
                  {
                    "text": "'NoneType' object has no attribute 'upper'"
                  }
                ],
                "tone": "error"
              },
              {
                "cells": [
                  {
                    "text": "ValueError"
                  },
                  {
                    "text": "int(\"abc\")"
                  },
                  {
                    "text": "ValueError"
                  }
                ],
                "tone": "error"
              },
              {
                "cells": [
                  {
                    "text": "ZeroDivisionError"
                  },
                  {
                    "text": "sum([]) / len([])"
                  },
                  {
                    "text": "division by zero"
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Calling len on a number raises TypeError because integers have no length.",
            "whatIf": "broken = [\n    lambda: totl,\n    lambda: 20 + \"45\",\n    lambda: {\"amount\": 20}[\"amont\"],\n    lambda: [1, 2, 3][3],\n    lambda: None.upper(),\n    lambda: int(\"abc\"),\n    lambda: sum([]) / len([]),\n    lambda: len(5),\n]\nfor run in broken:\n    try:\n        run()\n    except Exception as error:\n        print(f\"{type(error).__name__}: {error}\")",
            "checks": [
              "TypeError: object of type 'int' has no len()"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "TypeError"
                  },
                  {
                    "text": "20 + \"45\""
                  },
                  {
                    "text": "TypeError"
                  }
                ],
                "tone": "error"
              }
            ]
          }
        ]
      },
