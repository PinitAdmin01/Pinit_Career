    {
      "partTitle": "Reading a traceback, from the bottom up",
      "codeHash": "4253711d53039e6d1124ac5647ceeed617f522c5ac61e45c40c0c1908456a0a7",
      "spec": {
        "template": "table",
        "title": "Tracing TypeError back to the source value",
        "columns": [
          "Item",
          "Amount",
          "Outcome"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "When Python crashes, read the printed traceback from the bottom up.",
            "checks": [
              "TypeError"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "Tea"
                  },
                  {
                    "text": "20"
                  },
                  {
                    "text": "result"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "Bus"
                  },
                  {
                    "text": "\"45\""
                  },
                  {
                    "text": "TypeError"
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "The error message shows TypeError from adding text to a number.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "Bus"
                  },
                  {
                    "text": "\"45\""
                  },
                  {
                    "text": "TypeError"
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Changing the bus string to a number fixes the cause and yields total.",
            "whatIf": "def total(expenses):\n    result = 0\n    for e in expenses:\n        result = result + e[\"amount\"]\n    return result\n\nexpenses = [{\"item\": \"Tea\", \"amount\": 20}, {\"item\": \"Bus\", \"amount\": 45}]\nprint(total(expenses))",
            "checks": [
              "65"
            ],
            "mustNotShow": [
              "TypeError"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "Tea"
                  },
                  {
                    "text": "20"
                  },
                  {
                    "text": "result"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      },
