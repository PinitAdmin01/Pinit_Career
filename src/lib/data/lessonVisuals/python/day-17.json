    {
      "partTitle": "loads: from JSON text back to Python",
      "codeHash": "c27ac0756cd54a1e6a787a0c669e767d0547bf7e954d29bd8d9c610af10be7cc",
      "spec": {
        "template": "table",
        "title": "Loading JSON text to Python",
        "columns": [
          "Expression",
          "Result",
          "Type"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Use loads to turn JSON text into Python data.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "json.loads(text)"
                  },
                  {
                    "text": "Bus"
                  },
                  {
                    "text": "<class 'list'>"
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
