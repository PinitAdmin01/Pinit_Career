    {
      "partTitle": "Handling broken or unexpected data",
      "codeHash": "6235957dbc279961345a638f40e90d22e5248c0d650d7d9b0d45a04fc769d3e4",
      "spec": {
        "template": "table",
        "title": "Validating JSON inputs",
        "columns": [
          "Input",
          "Condition",
          "Returned"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Broken text causes json.loads to raise JSONDecodeError.",
            "checks": [
              "[{'item': 'Tea'}]",
              "[]"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "[{\"item\": \"Tea\"}]"
                  },
                  {
                    "text": "isinstance(data, list)"
                  },
                  {
                    "text": "[{'item': 'Tea'}]"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "\"[{broken\""
                  },
                  {
                    "text": "ValueError"
                  },
                  {
                    "text": "[]"
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "say3",
            "caption": "Check isinstance(data, list) to reject the wrong shape.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "\"\""
                  },
                  {
                    "text": "ValueError"
                  },
                  {
                    "text": "[]"
                  }
                ],
                "tone": "idle"
              },
              {
                "cells": [
                  {
                    "text": "{\"item\": \"Tea\"}"
                  },
                  {
                    "text": "isinstance(data, list)"
                  },
                  {
                    "text": "[]"
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Calling json.loads directly raises an error on broken text.",
            "whatIf": "import json\njson.loads(\"[{broken\")",
            "checks": [
              "JSONDecodeError"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "\"[{broken\""
                  },
                  {
                    "text": "json.loads"
                  },
                  {
                    "text": "error"
                  }
                ],
                "tone": "error"
              }
            ]
          }
        ]
      },
