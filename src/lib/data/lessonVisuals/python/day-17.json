                    "text": "expenses[1][\"item\"]"
                  },
                  {
                    "text": "Bus"
                  },
                  {
                    "text": "list"
                  }
                ],
                "tone": "data"
              }
            ]
          },
          {
            "at": "say4",
            "caption": "Running dumps then loads completes the round trip.",
            "checks": [
              "<class 'list'>",
              "Bus",
              "65",
              "True"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "sum(e[\"amount\"] for e in expenses)"
                  },
                  {
                    "text": "65"
                  },
                  {
                    "text": "expenses"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "json.loads(json.dumps(expenses)) == expenses"
                  },
                  {
                    "text": "True"
                  },
                  {
                    "text": "round trip"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
