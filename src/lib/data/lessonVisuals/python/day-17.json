    {
      "partTitle": "Dates and other values JSON cannot store",
      "codeHash": "53ef7a0eabb381195434d03d6b271800c0dcde49a950acf4102fa032275868ad",
      "spec": {
        "template": "table",
        "title": "Dates, tuples, and sets in JSON",
        "columns": [
          "Python Value",
          "Action",
          "Result"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "Saving a date directly raises a TypeError from json.dumps.",
            "checks": [
              "Error: Object of type date is not JSON serializable",
              "{\"date\": \"2026-09-28\", \"point\": [1, 2]}",
              "2026 [1, 2]"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "date(2026, 9, 28)"
                  },
                  {
                    "text": "json.dumps"
                  },
                  {
                    "text": "TypeError"
                  }
                ],
                "tone": "error"
              },
              {
                "cells": [
                  {
                    "text": "(1, 2)"
                  },
                  {
                    "text": "json.dumps"
                  },
                  {
                    "text": "[1, 2]"
                  }
                ],
                "tone": "data"
              }
            ]
          },
          {
            "at": "say3",
            "caption": "Convert dates with date.isoformat() before saving.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "today.isoformat()"
                  },
                  {
                    "text": "json.dumps"
                  },
                  {
                    "text": "\"2026-09-28\""
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "date.fromisoformat(back[\"date\"]).year"
                  },
                  {
                    "text": "json.loads"
                  },
                  {
                    "text": "2026"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Calling json.dumps on a set raises an error without sorted().",
            "whatIf": "import json\njson.dumps({\"tags\": {\"food\", \"daily\"}})",
            "checks": [
              "TypeError"
            ],
            "rows": [
              {
                "cells": [
                  {
                    "text": "{\"food\", \"daily\"}"
                  },
                  {
                    "text": "json.dumps"
                  },
                  {
                    "text": "error"
                  }
                ],
                "tone": "error"
              }
            ]
          }
        ]
      },
