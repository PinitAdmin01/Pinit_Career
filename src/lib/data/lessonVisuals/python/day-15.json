                "tone": "data"
              }
            ]
          },
          {
            "at": "say4",
            "caption": "strftime turns a date back into formatted text cleanly.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "due.strftime(\"%d %b %Y\")"
                  },
                  {
                    "out": 3
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "date(2028, 3, 1) - date(2028, 2, 1)"
