    {
      "partTitle": "Your own modules",
      "codeHash": "659a3beb2ce9acecc549a2110d9f2a97039c0a9565e2e0d9c16ffe4597a0f1d3",
      "spec": {
        "template": "table",
        "title": "Module execution check with __name__",
        "columns": [
          "Check",
          "Output"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Top-level module code runs directly inside the main block.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "__name__"
                  },
                  {
                    "out": 1
                  }
                ],
                "tone": "data"
              }
            ]
          },
          {
            "at": "say4",
            "caption": "__name__ holds __main__ when you run the script yourself.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "__name__"
                  },
                  {
                    "out": 1
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "if __name__ == \"__main__\":"
                  },
                  {
                    "out": 2
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Changing __main__ to reports skips the block like an imported file.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "\"reports\""
                  },
                  {
                    "text": "if __name__ == \"__main__\":"
                  }
                ],
                "tone": "idle"
              }
            ]
          }
        ]
      },
