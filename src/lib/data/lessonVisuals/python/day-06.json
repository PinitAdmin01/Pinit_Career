    {
      "partTitle": "break and continue",
      "codeHash": "acd2033e36cafcffb7bb26408e92b8089e74c4c606670f63375d5b90983ce832",
      "spec": {
        "template": "table",
        "title": "Control flow: continue and break",
        "columns": [
          "Condition",
          "Effect"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "When amount is over 500, break stops the loop immediately.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "if amount > 500:"
                  },
                  {
                    "out": 1
                  }
                ],
                "tone": "error"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "continue skips 0 and negative amounts and jumps to the next value.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "if amount <= 0:"
                  },
                  {
                    "text": "continue"
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "total = total + amount"
                  },
                  {
                    "out": 2
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Lowering 900 below 500 skips break so total reaches 305 across all items.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "Change 900 to 90"
                  },
                  {
                    "text": "305"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      },
