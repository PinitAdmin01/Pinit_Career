    {
      "partTitle": "Looping over text and range()",
      "codeHash": "ff2143e9db24fe6f60780deb9b2d50229d044bbb8f81d033f415cab655457193",
      "spec": {
        "template": "table",
        "title": "Looping over text and range()",
        "columns": [
          "Loop",
          "Produced values"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Looping over a string produces one character at a time.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "for letter in \"Tea\":"
                  },
                  {
                    "text": "letter"
                  }
                ],
                "tone": "data"
              }
            ]
          },
          {
            "at": "say3",
            "caption": "range(1, 4) stops before 4 while range(0, 20, 5) jumps by 5.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "for day in range(1, 4):"
                  },
                  {
                    "out": 4
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "for n in range(0, 20, 5):"
                  },
                  {
                    "out": 7
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Using range() for a times table repeats the indented print line.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "for i in range(1, 11):"
                  },
                  {
                    "text": "print(7, \"x\", i, \"=\", 7 * i)"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      },
