      "spec": {
        "template": "table",
        "title": "Rounding decimals for money",
        "columns": [
          "Expression",
          "Result"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Decimal arithmetic like 0.1 + 0.2 leaves a tiny storage error.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "0.1 + 0.2"
