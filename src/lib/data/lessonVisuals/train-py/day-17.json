      "partTitle": "Resuming exactly",
      "codeHash": "f83ece10742efb896db5b82fb5fcca91b7dde70a39ff45bea33afef755ce292a",
      "spec": {
        "template": "sequence",
        "title": "Resuming exactly",
        "actors": [
          "saved_t",
          "t"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Resuming means loading the checkpoint and restoring every piece.",
            "activeActor": "saved_t",
            "messages": [
              {
                "from": "saved_t",
                "to": "t",
                "label": {
                  "var": "saved_t",
                  "line": 4,
                  "hit": 1
                },
                "tone": "data"
              },
              {
                "from": "t",
                "to": "saved_t",
                "label": {
                  "var": "t",
                  "line": 2,
                  "hit": 1
                },
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "If everything is restored, the loss curve continues smoothly, as if.",
            "activeActor": "t",
            "messages": [
              {
                "from": "saved_t",
                "to": "t",
                "label": {
                  "var": "saved_t",
                  "line": 5,
                  "hit": 1
                },
                "tone": "data"
              },
              {
                "from": "t",
                "to": "saved_t",
                "label": {
                  "var": "t",
                  "line": 2,
                  "hit": 2
                },
                "tone": "ok"
              }
            ]
          },
