          {
            "id": "originServer",
            "label": "Origin Server"
          }
        ],
        "messages": [
          {
            "from": "attacker",
            "to": "cdnEdge",
            "label": "Inject Malicious Unkeyed Forwarded Headers",
            "tone": "error"
          },
          {
            "from": "cdnEdge",
            "to": "cdnEdge",
            "label": "Normalize Cache Key Ignoring Unkeyed Headers",
            "tone": "ok"
          },
          {
            "from": "cdnEdge",
            "to": "originServer",
            "label": "Forward Sanitized Request to Origin",
            "tone": "data"
          },
          {
            "from": "cdnEdge",
            "to": "attacker",
            "label": "Return Safe Cached Response to Clients",
            "tone": "ok"
          }
        ],
        "steps": [
