      "partTitle": "stale-while-revalidate & Cache Stampede Protection",
      "codeHash": "209ccca7eeb7a449452d2d06fac19da168b7791efb570ec92bf10cfaee310b6d",
      "spec": {
        "template": "states",
        "title": "Stale-while-revalidate cache entry freshness and background revalidation states",
        "states": [
          {
            "id": "fresh",
            "label": "Fresh Asset Under Max-Age"
          },
          {
            "id": "staleServed",
            "label": "Stale Asset Served Instantly"
          },
          {
            "id": "revalidating",
            "label": "Background Origin Fetch in Progress"
          },
          {
            "id": "refreshed",
            "label": "Cache Refreshed with New Payload"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Traditional cache expiration causes catastrophic stampede spikes.",
            "activeStateId": "staleServed",
            "statusBadge": "failed"
          },
          {
            "at": "say8",
            "caption": "The edge triggers background requests to refresh the cache.",
            "activeStateId": "revalidating",
            "statusBadge": "active"
          }
        ]
      },
