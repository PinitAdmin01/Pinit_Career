      "spec": {
        "template": "compare",
        "title": "Active-passive failover topology versus active-active multi-peer routing",
        "left": {
          "title": "Active-Passive Topology",
          "items": [
            "Primary serves 100% user traffic",
            "Secondary standby handles 0%",
            "Asynchronous data replication",
            "Simpler consistency guarantees"
          ]
        },
        "right": {
          "title": "Active-Active Topology",
          "items": [
            "Both regions serve active traffic",
            "Traffic routed by proximity",
            "Requires multi-master conflict logic",
            "Zero idle infrastructure waste"
          ]
