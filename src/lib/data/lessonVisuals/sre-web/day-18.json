    {
      "partTitle": "Correlation IDs: Tracing Causality Across Service Boundaries",
      "codeHash": "5dd0a005c7df324eaed99d5aa481f82d67ca8f9519e73912861646b665371b62",
      "spec": {
        "template": "sequence",
        "title": "Distributed transaction trace propagation via correlation identifiers",
        "actors": [
          "Client Ingress",
          "API Gateway",
          "Order Service",
          "Payment Service"
        ],
        "messages": [
          {
            "from": "Client Ingress",
            "to": "API Gateway",
            "label": "POST /checkout (No Correlation ID)"
          },
          {
            "from": "API Gateway",
            "to": "Order Service",
            "label": "RPC with x-correlation-id injected"
          },
          {
            "from": "Order Service",
            "to": "Payment Service",
            "label": "Forward request with x-correlation-id"
          },
          {
            "from": "Payment Service",
            "to": "API Gateway",
            "label": "Correlated response token"
          }
        ],
        "steps": [
          {
            "at": "say6",
            "caption": "The API gateway generates unique correlation identifiers for incoming calls.",
            "activeMessages": [
              0,
              1
            ]
          },
          {
            "at": "say8",
            "caption": "Downstream microservices inject correlation identifiers into emitted logs.",
            "activeMessages": [
              2,
              3
            ]
          }
        ]
      },
