      "partTitle": "The next greater element",
      "codeHash": "b6cce9533304d16e90e090373a7e5f0a3b61c62e612f10d0bcd4df1c32bd454b",
      "spec": {
        "template": "stack-queue",
        "title": "The next greater element",
        "mode": "queue",
        "steps": [
          {
            "at": "say1",
            "caption": "For each number in a list, find the first number to its right that is bigger.",
            "items": {
              "var": "nums",
              "line": 2,
              "hit": 1
            },
            "action": "enqueue"
          },
          {
            "at": "say2",
            "caption": "The simple way checks every later number for every number.",
            "items": {
              "var": "nums",
              "line": 3,
              "hit": 1
            },
            "action": "enqueue"
          },
          {
            "at": "say5",
            "caption": "By keeping the stack strictly ordered, you eliminate the quadratic O(N^2).",
            "items": {
              "var": "nums",
              "line": 5,
              "hit": 4
            },
            "action": "idle"
          }
        ]
