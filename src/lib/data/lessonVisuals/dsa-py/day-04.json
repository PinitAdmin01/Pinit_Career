      "partTitle": "What \"monotonic\" means",
      "codeHash": "c06d234cd1dc1a54f49d8e9b80cbfe0656ea29a56b8adcf1be11c4b29cede7e5",
      "spec": {
        "template": "stack-queue",
        "title": "What \"monotonic\" means",
        "mode": "stack",
        "steps": [
          {
            "at": "say1",
            "caption": "In the next greater solution, the numbers at the waiting positions always.",
            "items": {
              "var": "temps",
              "line": 2,
              "hit": 1
            },
            "action": "push"
          },
          {
            "at": "say2",
            "caption": "We keep it decreasing by popping anything smaller than the new number.",
            "items": {
              "var": "temps",
              "line": 3,
              "hit": 1
            },
            "action": "push"
          },
          {
            "at": "say4",
            "caption": "For \"next smaller\", flip the comparison.",
            "items": {
              "var": "temps",
              "line": 4,
              "hit": 3
            },
            "action": "idle"
          }
        ]
