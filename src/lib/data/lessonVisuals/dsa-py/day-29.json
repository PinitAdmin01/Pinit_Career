    {
      "partTitle": "XOR magic: single number",
      "codeHash": "d602dd10928d03a00a0b03a9b4deb496f9c04cfdde8b0b39e6a06c0417ac031b",
      "spec": {
        "template": "table",
        "title": "XOR self-cancellation mathematical properties",
        "columns": [
          "XOR Identity",
          "Mathematical Property",
          "Cancellation Outcome"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "XOR rules dictate that a number cancels itself and zero leaves x.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "x ^ x = 0"
                  },
                  {
                    "text": "Self-inversion"
                  },
                  {
                    "text": "Duplicate cancels out"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say3",
            "caption": "Every pair cancels to zero leaving only the single number.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "x ^ x = 0"
                  },
                  {
                    "text": "Self-inversion"
                  },
                  {
                    "text": "Duplicate cancels out"
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "x ^ 0 = x"
                  },
                  {
                    "text": "Identity"
                  },
                  {
                    "text": "Single number preserved"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      },
