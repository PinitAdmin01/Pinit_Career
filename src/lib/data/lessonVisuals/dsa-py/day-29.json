    {
      "partTitle": "Bitmasks as tiny sets",
      "codeHash": "ec7d9a30c5a4051845d014fb1d44a423d29ed962240c973e6ba1624923c510aa",
      "spec": {
        "template": "table",
        "title": "Set operations modeled via bitmask integer representation",
        "columns": [
          "Set Operation",
          "Bitwise Expression",
          "Complexity"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "A bitmask can represent any subset of items using bits.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "Include item i"
                  },
                  {
                    "text": "mask | (1 << i)"
                  },
                  {
                    "text": "O(1)"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "Adding checking or joining sets are single fast operations.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "Include item i"
                  },
                  {
                    "text": "mask | (1 << i)"
                  },
                  {
                    "text": "O(1)"
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "Test membership"
                  },
                  {
                    "text": "mask & (1 << i)"
                  },
                  {
                    "text": "O(1)"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      },
