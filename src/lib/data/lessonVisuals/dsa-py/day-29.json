    {
      "partTitle": "The bitwise operators",
      "codeHash": "20651d565d29952a5521d5f26a5ccec2bfaecf507b4ff449e5608e95bdeab237",
      "spec": {
        "template": "table",
        "title": "Bitwise operator logic and arithmetic identities",
        "columns": [
          "Bitwise Operator",
          "Operation Logic",
          "Arithmetic Effect"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Bitwise keeps a bit only if present in both or either operand.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "AND (&)"
                  },
                  {
                    "text": "1 only if both bits are 1"
                  },
                  {
                    "text": "Bit masking"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "Shifts left or right by k places multiplying or dividing.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "AND (&)"
                  },
                  {
                    "text": "1 only if both bits are 1"
                  },
                  {
                    "text": "Bit masking"
                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "Shift (<<, >>)"
                  },
                  {
                    "text": "Shifts bits left or right"
                  },
                  {
                    "text": "Multiply / divide by 2^k"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      },
