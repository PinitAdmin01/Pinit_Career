                "label": {
                  "var": "log",
                  "line": 2,
                  "hit": 1
                },
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "Otherwise keep log[:prev_index + 1], add the new entries (dropping any.",
            "activeActor": "log",
            "messages": [
              {
                "from": "follower",
                "to": "log",
                "label": {
                  "var": "follower",
                  "line": 8,
                  "hit": 1
                },
                "tone": "data"
              },
              {
                "from": "log",
                "to": "prev_index",
                "label": {
                  "var": "log",
                  "line": 4,
                  "hit": 1
                },
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say6",
            "caption": "By induction, if every append passes this check, follower logs always.",
            "activeActor": "prev_index",
            "messages": [
              {
                "from": "follower",
                "to": "log",
                "label": {
                  "var": "follower",
                  "line": 9,
                  "hit": 1
                },
                "tone": "data"
              },
              {
                "from": "log",
                "to": "prev_index",
                "label": {
                  "var": "log",
                  "line": 5,
                  "hit": 1
                },
                "tone": "ok"
              }
            ]
          }
        ]
