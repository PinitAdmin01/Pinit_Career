    {
      "partTitle": "The follower's consistency check",
      "codeHash": "01b642c332fab6905568fb84afd334b8b5e37075383d5a2ea7b2f78b08baa3df",
      "spec": {
        "template": "sequence",
        "title": "The follower's consistency check",
        "actors": [
          "follower",
          "log",
          "prev_index"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Append_entries(log, prev_index, prev_term, entries).",
            "activeActor": "follower",
            "messages": [
