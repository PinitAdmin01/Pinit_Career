      "partTitle": "Amdahl's law",
      "codeHash": "560e35bd8eab740627f5d7b4c4cc24a950ffc6a683c95e61d450af2e68b5319f",
      "spec": {
        "template": "cells",
        "title": "Amdahl's law",
        "steps": [
          {
            "at": "say1",
            "caption": "Vectorising part of a program speeds up only that part.",
            "items": {
              "var": "row",
              "line": 5,
              "hit": 5
            },
            "pointers": [
              {
                "name": "idx",
                "index": 0,
                "tone": "data"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "If a fraction p of the work gets a speedup of s (here, the vector width).",
            "items": {
              "var": "row",
              "line": 5,
              "hit": 9
            },
            "pointers": [
              {
                "name": "idx",
                "index": 1,
                "tone": "data"
              }
            ]
          },
          {
            "at": "say7",
            "caption": "Even infinite width cannot beat 1 / (1 - p).",
            "items": {
              "var": "row",
              "line": 5,
              "hit": 12
            },
            "pointers": [
              {
                "name": "idx",
                "index": 2,
