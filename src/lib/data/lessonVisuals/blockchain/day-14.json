      "spec": {
        "template": "sequence",
        "title": "Spot Price Oracles & Single-Block Liquidity Manipulation — Oracle Security Sequence",
        "actors": [
          "Lending Protocol",
          "Chainlink DON Oracle",
          "Uniswap TWAP Pool",
          "Liquidation Vault"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Protocol initiates multi-oracle price query for Spot Price Oracles &.",
            "activeActor": "Lending Protocol",
            "messages": [
              {
                "from": "Lending Protocol",
                "to": "Chainlink DON Oracle",
                "label": "latestRoundData()",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Chainlink nodes submit threshold-signed median price with heartbeat check.",
            "activeActor": "Chainlink DON Oracle",
            "messages": [
              {
                "from": "Chainlink DON Oracle",
                "to": "Lending Protocol",
                "label": "return(roundId, answer, updatedAt) [Fresh ✓]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Protocol samples Uniswap TWAP accumulator to cross-check deviation.",
            "activeActor": "Uniswap TWAP Pool",
            "messages": [
              {
                "from": "Lending Protocol",
                "to": "Uniswap TWAP Pool",
                "label": "observe(30m_window) -> return(twapPrice)",
                "tone": "data"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Dual-oracle consensus validates spread < OK bps; liquidations proceed.",
            "activeActor": "Liquidation Vault",
            "messages": [
              {
                "from": "Lending Protocol",
                "to": "Liquidation Vault",
                "label": "assertDeviation(spread < 2%) [Conservative Min Price]",
                "tone": "ok"
              },
              {
                "from": "Liquidation Vault",
                "to": "Lending Protocol",
                "label": "OracleConsensusApproved(Safe ✓)",
                "tone": "ok"
              }
            ]
          }
        ]
