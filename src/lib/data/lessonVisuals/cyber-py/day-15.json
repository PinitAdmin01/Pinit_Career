    {
      "partTitle": "Progressive lockout",
      "codeHash": "ebfabec89864be60edf4546656ba86c1d89af3d2dd13b6e6c006bfafa4414055",
      "spec": {
        "template": "compare",
        "title": "Standard fast hash verification versus memory-hard constant-time defense",
        "left": {
          "title": "Standard Fast Hash Verification",
          "items": [
            "Vulnerable to parallel graphics card cracking clusters",
            "Calculates matching characters with variable timing",
            "Microsecond leaks reveal credential prefixes over network"
          ]
        },
        "right": {
          "title": "Argon2id Constant-Time Guard",
          "items": [
            "High memory cost and multi pass compute requirements",
            "Compares every byte unconditionally using bitwise XOR",
            "Eliminates timing leaks across password verification"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "The module strictly enforces memory cost and time cost parameters.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Constant time verification compares every byte using bitwise operations.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Standard Fast Hash Verification",
        "rightLabel": "Argon2id Constant-Time Guard"
      },
