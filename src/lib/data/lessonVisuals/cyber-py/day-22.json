    {
      "partTitle": "ASLR and non-executable memory",
      "codeHash": "cfa80aa379f7e6e7e290acc5203889b73308a2998742359c2eb50718e8fc23bf",
      "spec": {
        "template": "compare",
        "title": "Deterministic memory layout versus Address Space Layout Randomization",
        "left": {
          "title": "Deterministic Static Memory",
          "items": [
            "Executables and libraries loaded at fixed predictable offsets",
            "Attackers hardcode target function addresses with ease",
            "Consistent memory addresses across all server restarts"
          ]
        },
        "right": {
          "title": "Randomized ASLR Memory",
          "items": [
            "Randomizes base addresses of stack heap and libraries",
            "Shared library functions reside at unpredictable offsets",
            "Blind jumps trigger immediate memory segmentation faults"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Predictable memory allowed attackers to hardcode fixed function addresses.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say5",
            "caption": "The operating system randomizes base memory addresses of libraries.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Deterministic Static Memory",
        "rightLabel": "Randomized ASLR Memory"
      },
