    {
      "partTitle": "Recovery and the blameless review",
      "codeHash": "2b61e3b0d0c6af80398bd19aa323502aeb3b26526f9cecdba5a81cf839d0802a",
      "spec": {
        "template": "compare",
        "title": "Standard operating system process listing versus hidden memory rootkits",
        "left": {
          "title": "Standard Process Listing",
          "items": [
            "Traverses ActiveProcessLinks doubly-linked list",
            "Enumerates standard operating system process threads",
            "Visible to standard administrative commands and pslist",
            "Represents benign user applications and services"
          ]
        },
        "right": {
          "title": "Hidden Rootkit Processes",
          "items": [
            "Unlinked from active operating system process list",
            "Remains active inside kernel thread scheduler",
            "Exposed through structure discrepancy tools like psxview",
            "Hides injected dynamic libraries and in-memory malware"
          ]
        },
        "steps": [
          {
            "at": "say6",
            "caption": "Rootkit malware unlinks processes to evade standard system process listings.",
            "highlightSide": "right",
            "statusBadge": "failed"
          },
          {
            "at": "say7",
            "caption": "Structure discrepancy analysis reveals hidden rootkit processes in memory.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Standard Process Listing",
        "rightLabel": "Hidden Rootkit Processes"
      },
