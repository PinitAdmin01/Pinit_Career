    {
      "partTitle": "Implementing TOTP",
      "codeHash": "0d5d533166c80a0d7c6b7bcc32518f8c927b0b2e881f4241e2aa3dbb22b15cde",
      "spec": {
        "template": "compare",
        "title": "Counter-based HOTP statefulness versus time-based TOTP epoch discretization",
        "left": {
          "title": "Stateful HOTP Counter",
          "items": [
            "Requires maintaining counter state on token and server",
            "Vulnerable to button press desynchronization drift",
            "Requires look-ahead resynchronization search loops"
          ]
        },
        "right": {
          "title": "Stateless TOTP Time-Step",
          "items": [
            "Counter derived directly from physical Unix epoch time",
            "Discrete thirty-second intervals synchronized via NTP",
            "Operates completely offline without database state"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "The algorithm discretizes continuous time into discrete time steps.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Authenticator apps require zero internet access to generate valid codes.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Stateful HOTP Counter",
        "rightLabel": "Stateless TOTP Time-Step"
      },
