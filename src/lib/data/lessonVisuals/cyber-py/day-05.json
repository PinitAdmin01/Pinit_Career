    {
      "partTitle": "Combining the rules",
      "codeHash": "aaa9323ca9586ea87d2a0124a9df9c131210d06368b98ec22b1a1707967762ad",
      "spec": {
        "template": "compare",
        "title": "Malicious SQL payload detection versus sanitized input parameterization",
        "left": {
          "title": "Detected Malicious Payload",
          "items": [
            "Contains tautology pattern OR 1=1",
            "Comment delimiters -- and /* detected",
            "Triggers immediate WAF rejection and audit log"
          ]
        },
        "right": {
          "title": "Sanitized Parameterized Query",
          "items": [
            "Stripped of illegal control characters",
            "Unicode representations normalized",
            "Forwarded to database via prepared statement"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Key patterns include tautology expressions and comment delimiters.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say6",
            "caption": "The engine sanitizes acceptable inputs stripping control characters.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Detected Malicious Payload",
        "rightLabel": "Sanitized Parameterized Query"
      },
