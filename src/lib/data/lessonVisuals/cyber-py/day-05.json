    {
      "partTitle": "Safe upload filenames",
      "codeHash": "79fac48ca7ebfb5532346ae804527b7a8afc6472e12232a5b92201c5a8f57599",
      "spec": {
        "template": "sequence",
        "title": "WAF input entity encoding and CSP response header injection sequence",
        "actors": [
          {
            "id": "client",
            "label": "HTTP Client"
          },
          {
            "id": "wafXss",
            "label": "WAF XSS Sanitizer"
          },
          {
            "id": "appBackend",
            "label": "Application Backend"
          }
        ],
        "messages": [
          {
            "from": "client",
            "to": "wafXss",
            "label": "Transmit Request with Script Tags in Body",
            "tone": "error"
          },
          {
            "from": "wafXss",
            "to": "appBackend",
            "label": "Forward Payload with HTML Entities Encoded",
            "tone": "ok"
          },
          {
            "from": "appBackend",
            "to": "wafXss",
            "label": "Generate Raw HTTP Response Data",
            "tone": "data"
          },
          {
            "from": "wafXss",
            "to": "client",
            "label": "Attach Strict CSP Nonce Header to Response",
            "tone": "ok"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Dangerous characters are transformed into safe named entities.",
            "activeMessageIndex": 1,
            "statusBadge": "active"
          },
          {
            "at": "say5",
            "caption": "The waf generates a cryptographic nonce and attaches a strict header.",
            "activeMessageIndex": 3,
            "statusBadge": "completed"
          }
        ]
      },
