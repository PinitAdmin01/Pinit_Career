    {
      "partTitle": "Matching packets",
      "codeHash": "97ebc722e97a6a050db1e75272a5f473612f90a3bfa01c32066d31297bf8b98d",
      "spec": {
        "template": "compare",
        "title": "Signature-based pattern matching versus protocol anomaly detection",
        "left": {
          "title": "Signature-Based Pattern Matching",
          "items": [
            "Searches packet payloads for documented exploit byte patterns",
            "Extremely efficient with near zero false positive rates",
            "Blind to unknown zero-day attacks and polymorphic payloads"
          ]
        },
        "right": {
          "title": "Protocol Anomaly Detection",
          "items": [
            "Models normal protocol standards and RFC specifications",
            "Flags unexpected deviations illegal headers and port abuse",
            "Catches novel zero-day attacks and evasive techniques"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Signatures search packet payloads for specific byte sequences.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Anomaly detection models normal specifications and flags deviations.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Signature-Based Pattern Matching",
        "rightLabel": "Protocol Anomaly Detection"
      },
