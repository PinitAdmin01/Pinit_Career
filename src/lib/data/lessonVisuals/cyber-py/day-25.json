    {
      "partTitle": "IDS and IPS",
      "codeHash": "d5e02b2c68ccb4ba20fbd266fc4cbb0c0de2dee9c16eeefa89acfabf788951d5",
      "spec": {
        "template": "compare",
        "title": "Network-based promiscuous sniffing versus host-based operating system IDS",
        "left": {
          "title": "Network Intrusion Detection (NIDS)",
          "items": [
            "Operates promiscuously on network taps and switch SPAN ports",
            "Analyzes raw Ethernet frames across entire network subnets",
            "Inspects unencrypted packet headers without host overhead"
          ]
        },
        "right": {
          "title": "Host Intrusion Detection (HIDS)",
          "items": [
            "Resides directly on individual endpoints and servers",
            "Monitors local system calls authentication logs and rootkits",
            "Inspects decrypted payload contents directly at the endpoint"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Network sensors analyze raw packets across subnets without host burdens.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Host monitors inspect local system calls and authentication logs.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Network Intrusion Detection (NIDS)",
        "rightLabel": "Host Intrusion Detection (HIDS)"
      },
