        "left": {
          "title": "Argon2d Variant",
          "items": [
            "Data-dependent memory addressing matrix",
            "Maximum resistance against GPU cracking farms",
            "Potential vulnerability to cache timing side channels"
          ]
        },
        "right": {
          "title": "Argon2id Hybrid",
          "items": [
            "Combines data-independent and data-dependent passes",
            "Defeats side-channel attacks during initial passes",
            "Mandated gold standard by RFC 9106 and OWASP"
          ]
        },
        "steps": [
