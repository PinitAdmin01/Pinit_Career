    {
      "partTitle": "Auditing headers",
      "codeHash": "eaca3f2dd4eefb60084b149a20e79cc1ecab25334fa7e6dd605195abae12a935",
      "spec": {
        "template": "compare",
        "title": "Permissive browser MIME sniffing versus strict nosniff directive",
        "left": {
          "title": "Permissive MIME Sniffing",
          "items": [
            "Browser inspects initial response bytes to deduce type",
            "Malicious uploads containing script executed as code",
            "Enables cross site scripting through media uploads"
          ]
        },
        "right": {
          "title": "Strict Nosniff Directive",
          "items": [
            "Browser strictly respects declared response content type",
            "Non script files refused execution as executable code",
            "Completely neutralizes media mime confusion attacks"
          ]
        },
        "steps": [
          {
            "at": "say5",
            "caption": "Older browsers might sniff script tags and execute files as JavaScript.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say8",
            "caption": "The browser is forced to adhere strictly to declared header types.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Permissive MIME Sniffing",
        "rightLabel": "Strict Nosniff Directive"
      },
