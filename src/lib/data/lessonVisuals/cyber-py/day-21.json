    {
      "partTitle": "Summarising decisions",
      "codeHash": "602e08029c92049a053cd8199fd9da3db687b216cc624d7a6eedb1f3b409ca91",
      "spec": {
        "template": "compare",
        "title": "Unprotected code commits versus shift-left entropy pre-commit hook",
        "left": {
          "title": "Unprotected Git Commit",
          "items": [
            "Exposes high entropy cryptographic keys in public feeds",
            "Bots scrape leaked credentials within seconds of commit",
            "Permanent history retention requires complex repository purge"
          ]
        },
        "right": {
          "title": "Shift-Left Entropy Hook",
          "items": [
            "Pre-commit hook inspects staged code modifications",
            "Combines vendor regex patterns with Shannon entropy",
            "Aborts commit immediately preventing secret leaks"
          ]
        },
        "steps": [
          {
            "at": "say5",
            "caption": "Candidate tokens are evaluated against the entropy threshold to verify keys.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Shift left prevention guarantees secrets never enter version control history.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Unprotected Git Commit",
        "rightLabel": "Shift-Left Entropy Hook"
      },
