    {
      "partTitle": "YAML and other loaders",
      "codeHash": "a0c86b35233baceff35482cc2ff9e389ca7845dbfc5d21f12ebc9e06c2f2d5ae",
      "spec": {
        "template": "compare",
        "title": "Unsafe binary object serialization versus declarative JSON schema validation",
        "left": {
          "title": "Unsafe Binary Serialization",
          "items": [
            "Encodes complex class hierarchies and method pointers",
            "Triggers automatic lifecycle magic hooks upon hydration",
            "Vulnerable to reflection gadget chains and code execution"
          ]
        },
        "right": {
          "title": "Declarative JSON Schema Validation",
          "items": [
            "Carries pure primitive data structures without class methods",
            "Enforces strict property types and rejects unknown fields",
            "Eliminates hidden lifecycle hooks and executable payloads"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Safe formats contain no class metadata or hidden lifecycle hooks.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "A robust schema validator inspects all required properties and types.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Unsafe Binary Serialization",
        "rightLabel": "Declarative JSON Schema Validation"
      },
