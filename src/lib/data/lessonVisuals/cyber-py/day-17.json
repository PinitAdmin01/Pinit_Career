        "template": "compare",
        "title": "PHP magic method object injection versus strict class whitelisting",
        "left": {
          "title": "Vulnerable Magic Methods",
          "items": [
            "Unserialize triggers wakeup and destruct automatically",
            "Attacker properties hijack internal object methods",
            "Constructs Property-Oriented Programming gadget chains"
          ]
        },
        "right": {
          "title": "Strict Allowed Classes Whitelist",
          "items": [
            "Replaces native unserialize with safe json decode",
            "Restricts deserialization strictly to trusted classes",
            "Blocks unauthorized object instantiation at runtime"
          ]
        },
        "steps": [
