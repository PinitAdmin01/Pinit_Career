    {
      "partTitle": "Allow-lists for outbound requests",
      "codeHash": "77a00f161be781a2107c2cb2bbfe0910d6337401a4cd63b2dfa604c5f1bda9d4",
      "spec": {
        "template": "compare",
        "title": "Unauthenticated IMDSv1 protocol versus session-token hardened IMDSv2",
        "left": {
          "title": "Vulnerable IMDSv1 Architecture",
          "items": [
            "Serves sensitive credentials over simple GET requests",
            "Exploitable through standard single request SSRF bugs",
            "Lacks mandatory session tokens or cryptographic checks"
          ]
        },
        "right": {
          "title": "Hardened IMDSv2 Protocol",
          "items": [
            "Mandates session-oriented PUT request with token header",
            "Requires secret session token on all subsequent GETs",
            "Neutralizes typical SSRF exploits lacking custom headers"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "IMDS requires a session oriented request with a mandatory token header.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Attackers cannot inject arbitrary headers to acquire session tokens.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Vulnerable IMDSv1 Architecture",
        "rightLabel": "Hardened IMDSv2 Protocol"
      },
