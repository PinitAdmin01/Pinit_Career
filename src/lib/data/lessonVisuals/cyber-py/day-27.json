      "spec": {
        "template": "compare",
        "title": "Legacy castle-and-moat perimeter model versus zero trust architecture",
        "left": {
          "title": "Castle and Moat Perimeter",
          "items": [
            "Trust everything inside corporate network",
            "Single boundary firewall defense",
            "Physical network location dictates trust",
            "Permits unrestricted internal lateral movement"
          ]
        },
        "right": {
          "title": "Zero Trust Architecture",
          "items": [
            "Never trust always verify requests",
            "Assume active breach across all workloads",
            "Continuous real time risk evaluation",
            "Granular least privilege enforcement"
          ]
        },
        "steps": [
          {
            "at": "say5",
            "caption": "Zero Trust principles mandate continuous verification and assumed breach.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
