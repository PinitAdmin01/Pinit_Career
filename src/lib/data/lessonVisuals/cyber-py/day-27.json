            "caption": "Every access request must be dynamically authenticated and authorized.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Castle and Moat Perimeter",
        "rightLabel": "Zero Trust Architecture"
      },
