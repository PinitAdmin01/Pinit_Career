      "spec": {
        "template": "table",
        "title": "Transport Layer Security protocol evolution TLS 1.2 versus TLS 1.3",
        "columns": [
          "Security Capability",
          "Legacy TLS 1.2 Protocol",
          "Modern TLS 1.3 Standard",
          "Architectural Advantage"
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Protocol upgrades reduce connection latency to a single round trip.",
            "activeRowIndex": 0,
            "statusBadge": "active",
            "rows": [
              {
                "cells": [
                  "Handshake Round-Trips",
                  "Two Round-Trips (2-RTT)",
                  "Single Round-Trip (1-RTT)",
                  "Halves connection setup latency"
                ],
                "tone": "data"
              },
              {
                "cells": [
                  "Forward Secrecy",
                  "Optional (Static RSA Allowed)",
                  "Mandatory (ECDHE Only)",
                  "Guarantees past sessions stay safe"
                ],
                "tone": "data"
              },
              {
                "cells": [
                  "Supported Ciphers",
                  "Weak CBC and RC4 Permitted",
                  "AEAD Ciphers Exclusively",
                  "Eliminates padding oracle exploits"
                ],
                "tone": "data"
              },
              {
                "cells": [
                  "Handshake Encryption",
                  "Cleartext Server Certificate",
                  "Encrypted Handshake Extensions",
                  "Prevents passive identity sniffing"
