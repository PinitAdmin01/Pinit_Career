    {
      "partTitle": "Chains of trust",
      "codeHash": "be7b810eda2773734597912aec5c247bfecd4563d8b5e78923a55bd11e78f734",
      "spec": {
        "template": "compare",
        "title": "Certificate revocation list overhead versus private OCSP stapling",
        "left": {
          "title": "Certificate Revocation List",
          "items": [
            "Large downloaded files listing all revoked serials",
            "Adds latency and bandwidth waste to connections",
            "Vulnerable to caching delays and stale lists"
          ]
        },
        "right": {
          "title": "OCSP Stapling (RFC 6066)",
          "items": [
            "Server staples timestamped CA status to TLS handshake",
            "Zero extra network round-trips for connecting clients",
            "Completely preserves user browsing privacy from CAs"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Revocation lists created massive connection latency and bandwidth waste.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say8",
            "caption": "Clients verify the digital signature with zero extra network round trips.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Certificate Revocation List",
        "rightLabel": "OCSP Stapling (RFC 6066)"
      },
