      "partTitle": "How SQL injection happens",
      "codeHash": "aa573b6567b5ecbe160d0761d2b8a4f0a8825635c94a3cd3a192c151e82a0235",
      "spec": {
        "template": "compare",
        "title": "Vulnerable dynamic SQL concatenation versus secure parameterized query architecture",
        "left": {
          "title": "Vulnerable Concatenation",
          "items": [
            "Raw user input interpolated into query template",
            "Attacker input modifies the query abstract syntax tree",
            "Bypasses authentication and leaks confidential tables"
          ]
        },
        "right": {
          "title": "Parameterized Statement",
          "items": [
            "SQL logic compiled ahead of execution phase",
            "User inputs bound purely as literal scalar values",
            "Input quotes and operators cannot alter command logic"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "SQL injection occurs when untrusted input is directly concatenated.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say9",
            "caption": "Prepared statements separate query logic from runtime parameters.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Vulnerable Concatenation",
        "rightLabel": "Parameterized Statement"
      },
