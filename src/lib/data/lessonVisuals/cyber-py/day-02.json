          {
            "at": "say9",
            "caption": "Once you understand this one idea, code versus data, many other injection.",
            "rows": [
              {
                "cells": [
                  "out 1",
                  "SELECT * FROM users WHERE email = 'asha@example.com'"
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  "out 2",
                  "SELECT * FROM users WHERE email = 'x' OR '1'='1'"
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  "out 3",
                  "the second query is true for every row: the input changed the SQL itself"
                ],
                "tone": "ok"
              }
            ]
          }
        ]
      }
