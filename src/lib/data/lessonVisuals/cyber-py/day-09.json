    {
      "partTitle": "Verifying an HS256 signature",
      "codeHash": "f8939627913e602742a2905e194da7b22b5cf4f3dcb8c3fae75188a7bd0ee337",
      "spec": {
        "template": "compare",
        "title": "Symmetric HS256 shared secret versus asymmetric RS256 key pair signing",
        "left": {
          "title": "Symmetric HS256 Signing",
          "items": [
            "Single shared secret key for signing and verifying",
            "Shared secret must exist across all verifying services",
            "Compromising one service exposes the enterprise secret"
          ]
        },
        "right": {
          "title": "Asymmetric RS256 Signing",
          "items": [
            "Private key signs tokens in secure auth server",
            "Public keys distributed via JWKS for verification",
            "Service compromise cannot forge administrative tokens"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Shared secrets introduce risks across microservice environments.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say6",
            "caption": "Microservices verify tokens using distributed public key sets.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Symmetric HS256 Signing",
        "rightLabel": "Asymmetric RS256 Signing"
      },
