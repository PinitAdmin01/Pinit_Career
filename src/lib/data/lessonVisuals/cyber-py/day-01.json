      "partTitle": "Threat modelling with STRIDE",
      "codeHash": "db417dc88618759158d4920bdec41c906d7f47b52107392e145ff8345f8ffdd9",
      "spec": {
        "template": "compare",
        "title": "Quantitative risk formula factors versus qualitative risk impact tiers",
        "left": {
          "title": "Quantitative Risk Formula",
          "items": [
            "Risk equals Threat times Vulnerability times Impact",
            "Measured numerically on standardized rating scales",
            "Computes annualized loss expectancy for controls"
          ]
        },
        "right": {
          "title": "Qualitative Severity Tiers",
          "items": [
            "Critical enterprise payment gateway vulnerabilities",
            "Moderate severity flaws in internal tools",
            "Negligible operational risk on air-gapped systems"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "The standard risk formula expresses risk as threat times impact.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Air-gapped systems with zero exposure experience negligible risk.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Quantitative Risk Formula",
        "rightLabel": "Qualitative Severity Tiers"
