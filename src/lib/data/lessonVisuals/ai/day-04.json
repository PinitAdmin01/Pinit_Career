          "title": "Evenly Split Ambiguity",
          "items": [
            "Disparate outputs fail to reach voting threshold",
            "Identifies edge case confusion across paths",
            "Flags query as ambiguous requiring escalation",
            "Triggers automated fallback human review"
          ]
        },
