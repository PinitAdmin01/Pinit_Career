      "steps": [
        {
          "step": 1,
          "caption": "Fetch on render architectures cause sequential network delays.",
          "data": {
            "left": {
              "title": "Sequential Waterfall",
              "items": [
                "Parent renders first",
                "Child fetches late",
                "Cumulative delay spikes"
              ]
            },
            "right": {
              "title": "Parallel Resolution",
              "items": [
                "Promises kicked early",
                "Concurrent requests",
                "Fast atomic render"
