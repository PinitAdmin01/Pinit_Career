      "partTitle": "Immutability as an Architectural Invariant: Why In-Place Object Mutation Breaks React State",
      "codeHash": "7daf6a5105dafea7f73402ce352d6952c030994c3421a680463ff544ad59455f",
      "spec": {
        "template": "compare",
        "title": "Mutable In-Place Mutation vs Immutable State Derivation",
        "left": {
          "title": "Mutable In-Place Mutation",
          "items": [
            "Overwrites existing heap payload",
            "Preserves identical memory pointer",
            "Fails React Object.is equality",
            "Triggers subtle silent UI bugs"
          ]
        },
        "right": {
          "title": "Immutable State Derivation",
          "items": [
            "Allocates brand new container copy",
            "Produces distinct memory pointer",
            "Enables O(1) shallow detection",
            "Guarantees predictable rendering"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Immutability is an architectural invariant ensuring system predictability."
          },
          {
            "at": "say2",
            "caption": "Mutable state requires expensive recursive traversal for change detection."
          },
          {
            "at": "say3",
            "caption": "Immutability enables fast shallow reference comparison in constant time."
          },
          {
            "at": "say4",
            "caption": "Immutable state snapshots allow concurrent rendering without tearing."
          }
        ]
      },
