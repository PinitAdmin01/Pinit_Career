    {
      "partTitle": "Throughput vs Latency Trade-Offs in AI Inference",
      "codeHash": "b0590f462444cfebae49ad00c1f5d7f1d8728bb8a89ad9ccb4f05fba41b5a747",
      "spec": {
        "template": "compare",
        "title": "Sequential 1-by-1 Calls vs Micro-Batched Invocations",
        "leftLabel": "Sequential One-by-One Calls",
        "rightLabel": "Micro-Batched Invocations",
        "leftItems": [
          "Incurs TCP handshake per request",
          "TLS negotiation and header churn",
          "20 requests = 2000ms total latency",
          "Low GPU tensor core utilization"
        ],
        "rightItems": [
          "Groups requests into single invocation",
          "Amortizes network overhead across items",
          "20 requests with batch factor 5 = 400ms",
          "Achieves 5x speedup for background jobs"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Sequential execution of individual tasks introduces massive networking overhead.",
            "highlightSide": "left"
          },
          {
            "at": "say6",
            "caption": "Micro-batching groups concurrent requests into a combined API invocation.",
            "highlightSide": "right"
          }
        ]
      },
