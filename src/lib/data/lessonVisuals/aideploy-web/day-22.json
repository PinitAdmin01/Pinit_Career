      "partTitle": "Faithfulness vs Relevance Scoring Distinction",
      "codeHash": "22b315a8cab861fbae50b0d4520c2d9e076e408627c09b97ad35b9242b8a7fbc",
      "spec": {
        "template": "compare",
        "title": "Context Faithfulness vs Query Relevance",
        "leftLabel": "Context Faithfulness",
        "rightLabel": "Query Relevance",
        "leftItems": [
          "Grounded in retrieved text",
          "Zero hallucinations allowed",
          "Verifies factual provenance"
        ],
        "rightItems": [
          "Directly answers user intent",
          "Excludes off-topic fluff",
          "Measures prompt alignment"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "Completions can be faithful to source documents while failing queries.",
            "highlightSide": "left"
          },
          {
            "at": "say3",
            "caption": "Answers can be relevant to queries while hallucinating ungrounded facts.",
            "highlightSide": "right"
          },
