      "codeHash": "f74aadd02c5ba456ce7fd2caca832c921a9893d55fe806bddb198f0c3342e287",
      "spec": {
        "template": "compare",
        "title": "Small Models vs Large Frontier Models Quantization",
        "leftLabel": "Small Models (< 10B Parameters)",
        "rightLabel": "Large Frontier Models (70B+)",
        "leftItems": [
          "Fewer redundant parameters in network",
          "Aggressive INT4 harms reasoning accuracy",
          "Noticeable degradation on coding tasks",
          "Recommend FP16 or high-bit INT8"
        ],
        "rightItems": [
          "High parameter redundancy in dense layers",
          "Tolerates INT4 with <0.5% perplexity loss",
          "Preserves reasoning and MMLU benchmarks",
          "INT4 is standard production deployment"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Large models tolerate aggressive quantization far better than small models.",
            "highlightSide": "right"
          },
          {
            "at": "say6",
            "caption": "Small models have fewer redundant parameters and degrade on four-bit formats.",
            "highlightSide": "left"
          }
        ]
      },
