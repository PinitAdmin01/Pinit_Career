      "partTitle": "Hedged Requests & Speculative Parallelism",
      "codeHash": "cafd6bd2883842471fe5055ed7e65a901556787c1de1f5b100dca20c7e3a998d",
      "spec": {
        "template": "compare",
        "title": "Single Provider Dispatch vs Speculative Hedged Race",
        "leftLabel": "Single Provider Dispatch",
        "rightLabel": "Speculative Hedged Race",
        "leftItems": [
          "Waits indefinitely on hung provider",
          "Vulnerable to worker GC pauses",
          "Tail latency spikes to 3000ms+",
          "Zero token redundancy cost"
        ],
        "rightItems": [
          "Dispatches hedge request after deadline",
          "Races primary against alternate region",
          "Reduces P99 latency by up to 75%",
          "Incurs modest 2% token hedge cost"
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Clients fire speculative hedge requests when primaries exceed deadlines.",
            "highlightSide": "right"
          },
          {
            "at": "say6",
            "caption": "Clients race requests and accept whichever response arrives first.",
            "highlightSide": "right"
          }
        ]
      },
