    {
      "partTitle": "Paragraph Boundary Preservation & Token Estimation",
      "codeHash": "9c7d8136c71b50256dd7eb1dc0666c191307764264d10667ac0b717747d5d313",
      "spec": {
        "template": "compare",
        "title": "Naive Character Slicing vs Paragraph Preservation",
        "leftLabel": "Naive Character Slicing",
        "rightLabel": "Paragraph-Aware Grouping",
        "leftItems": [
          "Arbitrary cuts in the middle of words",
          "Breaks syntactic sentences in half",
          "Mutilates reasoning in RAG retrieval",
          "Ignores authorial concept structure"
        ],
        "rightItems": [
          "Splits along double newline boundaries",
          "Treats complete thoughts as atomic units",
          "Groups paragraphs up to maximum budget",
          "Preserves narrative context for embeddings"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Treating paragraphs as atomic blocks avoids jagged sentence cuts.",
            "highlightSide": "right"
          },
          {
            "at": "say9",
            "caption": "Accumulating adjacent paragraphs prevents arbitrary mid-sentence cuts.",
            "highlightSide": "right"
          }
        ]
      },
