    {
      "partTitle": "Memory-Safe Architecture: Ownership, Borrow Checking & Rust Safety Invariants",
      "codeHash": "0814b90bd4c1ad9605d4538671ab3dea90f50ec7c6096a5ecf121bf10fc9c6bc",
      "spec": {
        "template": "compare",
        "title": "Manual pointer lifecycle pitfalls versus Rust compile-time ownership",
        "left": {
          "title": "Unmanaged Manual Pointers",
          "items": [
            "Manual allocation and deallocation via malloc and free",
            "Pointers can easily outlive their allocated object lifetime",
            "Data races and dangling pointers discovered only at runtime"
          ]
        },
        "right": {
          "title": "Rust Compile-Time Ownership",
          "items": [
            "Each value has exactly one owner dropped on scope exit",
            "Borrow checker enforces exclusive mutable reference rules",
            "Complete spatial and temporal safety without garbage collector"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Rust ownership rules dictate that values are dropped when owners exit scope.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "The borrow checker enforces strict rules on mutable and shared references.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Unmanaged Manual Pointers",
        "rightLabel": "Rust Compile-Time Ownership"
      },
