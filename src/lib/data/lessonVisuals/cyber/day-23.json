      "partTitle": "Spatial Memory Safety vs Temporal Memory Safety",
      "codeHash": "99cc3f9cc14f87464b9aef9ffc999713f8a7d43782e54453ccfff607b829d7bc",
      "spec": {
        "template": "compare",
        "title": "Spatial out-of-bounds bounds failure versus temporal lifetime invalidation",
        "left": {
          "title": "Spatial Safety Violations",
          "items": [
            "Operations access memory outside allocated buffer bounds",
            "Out of bounds array indexing and off-by-one errors",
            "Linear memory overwrites corrupting adjacent stack data"
          ]
        },
        "right": {
          "title": "Temporal Safety Violations",
          "items": [
            "Operations access memory outside valid object lifetimes",
            "Dereferencing dangling pointers after free or delete",
            "Use-after-free and double-free enabling heap hijacking"
          ]
        },
        "steps": [
