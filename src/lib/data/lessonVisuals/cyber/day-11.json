    {
      "partTitle": "Vertical & Horizontal Privilege Escalation Prevention",
      "codeHash": "1f409590d036a03efedc15b453604a3b63b33813a597ad4d432c873fa2ac0c20",
      "spec": {
        "template": "compare",
        "title": "Vertical administrative escalation versus horizontal tenant tampering",
        "left": {
          "title": "Vertical Privilege Escalation",
          "items": [
            "Low privilege users acquire rights of superior roles",
            "Endpoints assume only administrators will call them",
            "Missing server side role and capability validation"
          ]
        },
        "right": {
          "title": "Horizontal Privilege Escalation",
          "items": [
            "Attackers access resources of peer privilege tiers",
            "Tampering with object identifiers in request paths",
            "Failing to enforce tenant and ownership query scoping"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Vertical privilege escalation occurs when users acquire superior rights.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say7",
            "caption": "Data access queries must enforce ownership scoping to protect resources.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Vertical Privilege Escalation",
        "rightLabel": "Horizontal Privilege Escalation"
      },
