      "partTitle": "Authentication vs Authorization & The Coarse-Grained RBAC Model",
      "codeHash": "8aa65973957a8357e75d756323847513572334508e4f5d50c49d2ef0ba71502e",
      "spec": {
        "template": "compare",
        "title": "Authentication identity verification versus authorization access governance",
        "left": {
          "title": "Authentication Identity",
          "items": [
            "Verifies who the user claims to be",
            "Evaluates passwords or one-time codes",
            "Establishes authenticated principal id"
          ]
        },
        "right": {
          "title": "Authorization Access",
          "items": [
            "Governs what principals may perform",
            "Evaluates permissions against actions",
            "Groups permissions into assigned roles"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Authentication verifies the identity of an authenticated principal.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say5",
            "caption": "Individual permissions are grouped into roles assigned to users.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Authentication Identity",
        "rightLabel": "Authorization Access"
