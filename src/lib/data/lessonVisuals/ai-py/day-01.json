    {
      "partTitle": "From scores to probabilities: softmax",
      "codeHash": "b1c393d1ee42bd17bcb6238b7697a01a7fd4cf62b35acfa9b020ada879fd713b",
      "spec": {
        "template": "compare",
        "title": "Raw logit scores versus normalized probabilities",
        "leftLabel": "Raw Logits",
        "rightLabel": "Softmax Probabilities",
        "steps": [
          {
            "at": "say1",
            "caption": "Raw logits can be negative numbers that are difficult to compare directly.",
            "left": {
              "code": "logits = [2.0, 1.0, 0.1]",
              "result": {
                "text": "unbounded scales"
              },
              "tone": "data"
            },
            "right": {
              "code": "direct comparison",
              "result": {
                "text": "hard to interpret"
              },
              "tone": "error"
            }
          },
          {
            "at": "say2",
            "caption": "The softmax function transforms unbounded logits into positive probabilities.",
            "left": {
              "code": "exp(x - top)",
              "result": {
                "text": "positive weights"
              },
              "tone": "data"
            },
            "right": {
              "code": "sum to 1.0",
              "result": {
                "text": "[0.659, 0.2424, 0.0985]"
              },
              "tone": "ok"
            }
          }
        ]
      },
