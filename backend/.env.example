# PinIT Voice Backend — Environment Variables
# Copy to .env and fill in values.

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM (OpenRouter) ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Premium TTS (ElevenLabs — optional, used for interview mode only) ─────────
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ── Storage ───────────────────────────────────────────────────────────────────
AUDIO_STORAGE_DIR=./storage/audio
MAX_STORAGE_MB=2048

# ── Cache ─────────────────────────────────────────────────────────────────────
# Model version — change to invalidate all cached audio
MODEL_VERSION=v2.0
# Never expire cached audio — only LRU eviction when storage is full
CACHE_TTL_SECONDS=0

# ── Cloud CDN (optional — for multi-server horizontal scaling) ────────────────
# CDN_BUCKET_URL=https://your-r2-or-s3-bucket.com/audio

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
