    "qrcode.react": "^3.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.1",
    "three": "^0.185.0",
    "ws": "8.18.0",
    "zod": "^4.5.4",
    "zustand": "^4.5.2"
