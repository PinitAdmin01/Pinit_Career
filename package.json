  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node build.js",
    "start": "next start",
    "export": "next build",
    "deploy": "next build && firebase deploy --only hosting",
    "lint": "next lint",
    "audit:contracts": "node audit/extract-contracts.mjs",
    "audit:headers": "node audit/check-headers.mjs",
