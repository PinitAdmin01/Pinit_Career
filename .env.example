# Firebase Web Client Configuration (Example)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_app_hash

# Third-Party Service APIs (Face Verification & Supabase)
NEXT_PUBLIC_FACE_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anonymous_key

# Secure Serverless Backend API Keys (No NEXT_PUBLIC prefix - protected from client bundle)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# [ANCESTOR - ELEVENLABS] TTS is now handled by Kokoro + KittenTTS (offline, free, no key needed).
# ElevenLabs code is preserved as ancestor in src/lib/tts.ts and src/lib/hooks/useTTS.js.
# Uncomment and set this key only if you want to re-activate ElevenLabs voice synthesis.
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Voice Cache Backend (FastAPI) ─────────────────────────────────────────────
# URL of the running FastAPI voice backend (see backend/README.md)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: CDN bucket URL for multi-server audio sharing (Cloudflare R2 / S3 / Backblaze)
# NEXT_PUBLIC_CDN_VOICE_URL=https://your-cdn-bucket.com/audio

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by the FastAPI backend (not directly by Next.js)
REDIS_URL=redis://localhost:6379