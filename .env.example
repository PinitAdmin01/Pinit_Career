# Firebase Web Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_app_hash

# Supabase (anon key is public; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anonymous_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LLM providers (server-only — never NEXT_PUBLIC_)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Razorpay (server-only secret required for order create + HMAC verify)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Teacher portal credentials (REQUIRED — no weak defaults; min 8 chars)
TEACHER_DEMO_PASSWORD=
TEACHER_ADMIN_PASSWORD=

# Voice / TTS
NEXT_PUBLIC_TTS_API_URL=https://pinit-voice-service.onrender.com/api/v1/tts
NEXT_PUBLIC_RENDER_TIER=free
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_CDN_VOICE_URL=https://your-cdn-bucket.com/audio
# On Render voice-service, set the same Supabase URL/anon key used by the app so Tier-4 audio cache works:
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# Create a public Storage bucket named: voice_audio_cache

# Face service (optional)
NEXT_PUBLIC_FACE_API_URL=http://localhost:3001

# Redis (FastAPI voice backend)
REDIS_URL=redis://localhost:6379

# IMPORTANT ARCHITECTURE NOTE
# next.config.js currently uses output: 'export' for Firebase Hosting.
# App Router handlers under src/app/api/** do NOT run on static Firebase Hosting.
# For JWT-gated APIs / Razorpay verify / face enroll to work in production, host
# the Next.js app on a Node runtime (Vercel/Render/Cloud Run) OR proxy /api/* to
# a separate backend. Static export alone is client-router + Supabase only.
