# =================================================================
# PinIT Career OS — Environment Configuration Template
# Copy this file to .env.local: cp .env.example .env.local
# =================================================================

# ── 1. Backend & Neural Voice Engine ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TTS_API_URL=http://localhost:8000/api/tts
NEXT_PUBLIC_CDN_VOICE_URL=

# ── 2. Supabase Auth & Database (Optional for Demo Mode) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── 3. Razorpay Payments (Optional: Defaults to Sandbox Mode) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_DEV_MOCK_PAYMENT=true

# ── 4. App URL ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
